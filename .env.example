# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=REPLACE_WITH_PASSWORD

# Use @postgres:5432 inside Docker Compose; @localhost:5432 for local dev
DATABASE_URL=postgresql+asyncpg://trading:REPLACE_WITH_PASSWORD@postgres:5432/trading

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── AI / LLM keys ─────────────────────────────────────────────────────────────
# Used by LangGraph agent orchestrator and signal generation
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
OPENAI_MODEL=gpt-4o

# Used by cost_reviewer agent (claude-haiku)
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY

# ── Streamlit ─────────────────────────────────────────────────────────────────
# Use http://api:8000 inside Docker Compose; http://localhost:8000 outside
API_BASE_URL=http://api:8000

# ── Broker (Phase 5 — live execution only) ────────────────────────────────────
BROKER=paper
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# ── Market Data ───────────────────────────────────────────────────────────────
NSE_DATA_SOURCE=yfinance
HISTORICAL_DATA_DAYS=365

# ── Risk limits ───────────────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=2.0
DAILY_LOSS_LIMIT_PCT=3.0
MAX_DRAWDOWN_PCT=10.0

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=REPLACE_WITH_GRAFANA_PASSWORD

# ── AWS (only needed when deploying to AWS) ───────────────────────────────────
AWS_REGION=ap-south-1
