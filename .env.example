# Copy to .env and fill in your values
# Docker Compose reads this file automatically

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading

# ── Redis ─────────────────────────────────────────────────────────────────────
# (no password needed for local Redis)

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── AI / LLM keys (optional — agent features disabled if blank) ───────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=

# ── Broker (Phase 5 — live execution only; leave blank for paper trading) ─────
BROKER=paper
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# ── Market Data ───────────────────────────────────────────────────────────────
NSE_DATA_SOURCE=yfinance
HISTORICAL_DATA_DAYS=365

# ── Risk limits ───────────────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=2.0
DAILY_LOSS_LIMIT_PCT=3.0
MAX_DRAWDOWN_PCT=10.0

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
