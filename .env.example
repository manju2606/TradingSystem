# Database
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://trading:changeme@localhost:5432/trading

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=changeme-use-a-strong-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI / Agents
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Broker (for live execution - Phase 5)
BROKER=zerodha
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Market Data
NSE_DATA_SOURCE=yfinance   # yfinance | zerodha | nse_api
HISTORICAL_DATA_DAYS=365

# Risk limits
RISK_PER_TRADE_PCT=2.0
DAILY_LOSS_LIMIT_PCT=3.0
MAX_DRAWDOWN_PCT=10.0

# Monitoring
GRAFANA_PASSWORD=admin

# AWS (infra)
AWS_REGION=ap-south-1
